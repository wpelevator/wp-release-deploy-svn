{
	"compilerOptions": {
		"target": "es2023",
		"lib": [ "es2023" ],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"customConditions": [ "wpelevator-source" ],
		"types": [ "node" ],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [ "src" ]
}
