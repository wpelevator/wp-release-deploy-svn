{
	"private": true,
	"name": "@wpelevator/wp-release-deploy-svn-action",
	"version": "0.1.0",
	"description": "GitHub Action to deploy WordPress plugins and themes to WordPress.org SVN",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@wpelevator/wp-release": "^0.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@wordpress/scripts": "^33.0",
		"esbuild": "^0.27.7",
		"npm-run-all2": "^9.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "node build.js",
		"lint": "npm-run-all lint:*",
		"lint:js": "wp-scripts lint-js build.js src",
		"lint:types": "tsc -p tsconfig.json",
		"format": "wp-scripts format build.js src",
		"test": "node --test --conditions=wpelevator-source"
	}
}
